generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("staff") // admin, manager, staff
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  shifts    Shift[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  image     String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String   @unique
  barcode     String?  @unique
  description String?
  categoryId  String
  costPrice   Float    @default(0)
  sellPrice   Float    @default(0)
  image       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category          @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  orderItems  OrderItem[]
  stockMovements StockMovement[]
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  size      String
  color     String
  sku       String @unique
  barcode   String? @unique
  costPrice Float  @default(0)
  sellPrice Float  @default(0)
  stock     Int    @default(0)
  active    Boolean @default(true)

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  stockMovements StockMovement[]

  @@unique([productId, size, color])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  address   String?
  points    Int      @default(0)
  totalSpent Float   @default(0)
  debt      Float    @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  debtPayments DebtPayment[]
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  customerId    String?
  userId        String
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  discountType  String   @default("amount") // amount, percent
  total         Float    @default(0)
  paid          Float    @default(0)
  debt          Float    @default(0)
  paymentMethod String   @default("cash") // cash, transfer, card
  note          String?
  status        String   @default("completed") // completed, returned, cancelled
  createdAt     DateTime @default(now())

  customer   Customer?   @relation(fields: [customerId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  variantId  String?
  name       String
  variantInfo String?
  quantity   Int
  price      Float
  discount   Float   @default(0)
  total      Float

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  variantId  String?
  type       String   // in, out, adjustment
  quantity   Int
  reason     String?
  reference  String?
  createdAt  DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model DebtPayment {
  id         String   @id @default(cuid())
  customerId String
  amount     Float
  note       String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model Shift {
  id           String    @id @default(cuid())
  userId       String
  startAmount  Float     @default(0)
  endAmount    Float?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  note         String?

  user User @relation(fields: [userId], references: [id])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ─── Dream Team Models ───────────────────────────────────────

model DtOrder {
  id        String   @id @default(cuid())
  rowIndex  Int      @unique
  tenKhach  String   // customer name
  tenSp     String   // product name
  maSP      String   // product code
  size      String   @default("")
  color     String   @default("")
  soLuong   Int      @default(1)
  giaSp     Float    // price in JPY
  linkFb    String   @default("")
  trangThai String   @default("CHƯA ĐẶT") // status
  ngayOd    DateTime @default(now()) // order date
  note      String?  // includes 💰CK marks
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DtCatalog {
  id       String  @id @default(cuid())
  maSP     String  @unique
  tenSP    String
  giaBan   Float   // selling price JPY
  giaMua   Float?  // cost price
  link     String? // product link
  image    String?
  loiNhuan Int     @default(0)
  margin   Float   @default(0)
  sizes    String  @default("")
  colors   String  @default("")
  daBan    Int     @default(0)
  loai     String  @default("")
}

model DtAddress {
  id       String  @id @default(cuid())
  name     String
  fb       String  // Facebook link
  postal   String  @default("")
  pref     String  @default("")
  city     String  @default("")
  street   String  @default("")
  phone    String  @default("")
  soDon    Int     @default(0)
  tongSl   Int     @default(0)
  doanhThu Int     @default(0)
  giaTb    Int     @default(0)
  linkFb   String  @default("")
  hang     String  @default("")

  @@unique([name, fb])
}

model DtStock {
  id      String  @id @default(cuid())
  ma      String  // product code
  ten     String  // product name
  size    String  @default("")
  color   String  @default("")
  soLuong Int     @default(0)
  note    String?
  ngayNhap String @default("")
}

model DtEmsBatch {
  id        String   @id @default(cuid())
  emsCode   String
  createdAt DateTime @default(now())
  items     String   // JSON string
  skuCount  Int      @default(0)
  totalQty  Int      @default(0)
  chiTiet   String   @default("")
  status    String   @default("Đã nhập kho")
  lastCheck String   @default("")
  trackRaw  String   @default("")
}

model DtSurplus {
  id       String  @id @default(cuid())
  ma       String  // product code
  ten      String  // product name
  sz       String  @default("")
  cl       String  @default("")
  sl       Int     @default(0)
  note     String?
  trangThai String @default("Chờ hàng")
  ngayTao  String  @default("")
}

model DtSetting {
  key   String @id
  value String @default("")
}
